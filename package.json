{
  "name": "evan-personal-app",
  "private": true,
  "version": "0.1.0",
  "description": "个人生活助手：本地优先的日程 / 学习 / 读书 / 健身 / 饮食 / 娱乐计时 / 复盘一体化应用（Vue 3 + TS + Dexie，数据只存在本机浏览器）",
  "license": "MIT",
  "author": "Evan",
  "repository": {
    "type": "git",
    "url": "https://github.com/sdreamu/personal-app.git"
  },
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:5180": "vite --mode dev5180",
    "build": "vue-tsc --noEmit && vite build",
    "build:electron": "vue-tsc --noEmit && vite build --base=./",
    "electron:dev": "pnpm build:electron && electron .",
    "build:android": "pnpm build && cap sync android",
    "apk:debug": "pnpm build:android && cd android && gradlew.bat assembleDebug",
    "dist:win:out": "pnpm build:electron && electron-builder --win --config electron-builder.yml -c.directories.output=../evan-release",
    "dist:win": "pnpm build:electron && electron-builder --win --config electron-builder.yml",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:run": "vitest run",
    "typecheck": "vue-tsc --noEmit",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3",
    "dexie": "^4.0.11",
    "pinia": "^3.0.1",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.13.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.6",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^26.1.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^3.1.1",
    "vue-tsc": "^2.2.0"
  }
}
